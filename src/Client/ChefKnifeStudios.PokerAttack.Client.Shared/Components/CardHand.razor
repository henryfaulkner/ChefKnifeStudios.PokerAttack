<div class="card-hand">
    <div class="cards">
        @foreach (var card in Cards)
        {
            <div 
                class="card @(card.IsSelected ? "selected" : string.Empty)"
                @onclick="() => card.IsSelected = !card.IsSelected"
            >
                <img 
                    src="@CardImageService.GetCardImagePath(card.Suit, card.Rank)" 
                    alt="" 
                />
            </div>
        }
    </div>
</div>