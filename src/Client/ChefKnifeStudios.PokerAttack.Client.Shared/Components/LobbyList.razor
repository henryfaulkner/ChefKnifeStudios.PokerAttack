<div class="lobby-list">
    @if (LobbyViewModel.IsLoadingLobbies)
    {
        <MatBody1>Loading...</MatBody1>
    }
    else
    {
        <MatAccordion Multi="true">
            @foreach (var lobby in LobbyViewModel.Lobbies)
            {
                <MatExpansionPanel>
                    <MatExpansionPanelSummary>
                        <MatExpansionPanelHeader>Lobby Id: @lobby.GameId</MatExpansionPanelHeader>
                        <MatExpansionPanelSubHeader>
                            @if (!lobby.PlayerIds.Contains(ApplicationViewModel.PlayerId))
                            {
                                <MatButton 
                                    OnClick="() => HandleJoinLobbyPressed(lobby.GameId)" 
                                >
                                    JOIN LOBBY
                                </MatButton>
                            }
                        </MatExpansionPanelSubHeader>
                    </MatExpansionPanelSummary>
                    <MatExpansionPanelDetails>
                        <MatTable
                            Items="lobby.PlayerIds"
                            PageLabel="Players"
                            PageRecordCountLabel="Page Size"
                        >
                            <MatTableHeader>
                                <th class="col-header-id">Player Id</th>
                                <th class="col-header-actions"></th>
                            </MatTableHeader>
                            <MatTableRow>
                                <td class="col-row-id">@context</td>
                                <td class="col-row-actions">
                                    @if (@context == ApplicationViewModel.PlayerId)
                                    {
                                        <MatButton 
                                            OnClick="() => HandleLeaveLobbyPressed(lobby.GameId)" 
                                        >
                                            LEAVE LOBBY
                                        </MatButton>
                                    }
                                </td>
                            </MatTableRow>
                        </MatTable>
                    </MatExpansionPanelDetails>
                </MatExpansionPanel>
            }
        </MatAccordion>
    }
</div>