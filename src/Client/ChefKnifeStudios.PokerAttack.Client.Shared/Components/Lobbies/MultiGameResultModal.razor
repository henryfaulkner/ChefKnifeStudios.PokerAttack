@namespace ChefKnifeStudios.PokerAttack.Client.Shared.Components.Lobbies

<MatDialog Class="multi-game-result-modal" IsOpen="@(!string.IsNullOrWhiteSpace(GameResult))">
    <MatDialogContent>
        @switch (GameResult)
        {
            case "winner":
                <p class="mat-body1">You are a winner</p>
                break;
            case "loser":
                <p class="mat-body1">You are a loser</p>
                break;
        }
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="HandleClosePressed">CLOSE</MatButton>
    </MatDialogActions>
</MatDialog>

@code {
    [Parameter] public string? GameResult { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    async Task HandleClosePressed()
    {
        await OnClose.InvokeAsync();
    }
}
