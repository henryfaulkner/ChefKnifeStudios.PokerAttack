<div class="lobby-list">
    @if (LobbyViewModel.IsLoadingLobbies)
    {
        <MatBody1>Loading...</MatBody1>
    }
    else
    {
        <MatAccordion Multi="true">
            @foreach (var lobby in LobbyViewModel.Lobbies)
            {
                <MatExpansionPanel>
                    <MatExpansionPanelSummary>
                        <MatExpansionPanelHeader>
                            <span class="mat-body1">Lobby Id: @lobby.Id</span>
                        </MatExpansionPanelHeader>
                        <MatExpansionPanelSubHeader>
                            @if (lobby.GameId is string)
                            {
                                <span class="mat-body1">MATCH IN PROGRESS</span>
                            }
                            else if (!lobby.Players.Select(x => x.Id).Contains(ApplicationViewModel.Player.Id))
                            {
                                <MatButton 
                                    OnClick="() => HandleJoinLobbyPressed(lobby.Id)" 
                                    OnClickStopPropagation="true"
                                >
                                    Join Lobby
                                </MatButton>
                            } 
                            else if (lobby.HostPlayer.Id.Equals(ApplicationViewModel.Player.Id, StringComparison.InvariantCultureIgnoreCase))
                            {
                                <MatButton 
                                    OnClick="() => HandleStartGamePressed(lobby.Id)" 
                                    OnClickStopPropagation="true"
                                >
                                    Start Game
                                </MatButton>
                            }
                        </MatExpansionPanelSubHeader>
                    </MatExpansionPanelSummary>
                    <MatExpansionPanelDetails>
                        <MatTable
                            Items="lobby.Players"
                            PageLabel="Players"
                            PageRecordCountLabel="Page Size"
                        >
                            <MatTableHeader>
                                <th class="col-header-name mat-body1">Player Name</th>
                                <th class="col-header-actions mat-body1"></th>
                            </MatTableHeader>
                            <MatTableRow>
                                <td class="col-row-name mat-body1">@context.Name</td>
                                <td class="col-row-actions">
                                    @if (@context.Id == ApplicationViewModel.Player.Id)
                                    {
                                        <MatButton 
                                            OnClick="() => HandleLeaveLobbyPressed(lobby.Id)" 
                                        >
                                            LEAVE LOBBY
                                        </MatButton>
                                    }
                                </td>
                            </MatTableRow>
                        </MatTable>
                    </MatExpansionPanelDetails>
                </MatExpansionPanel>
            }
        </MatAccordion>
    }
</div>