<div class="editable-player-name">
    <MatTextField
        Label="You are"
        Required="true"
        Outlined="true"
        @bind-Value="@_name"
        OnFocus="HandleEditingStarted"
        OnFocusOut="HandleEditingStopped"
        Icon="refresh"
        IconTrailing="true"
        IconOnClick="HandleRandomizeNamePressed"
    />
</div>