@using ChefKnifeStudios.PokerAttack.Client.Core.Services
@using ChefKnifeStudios.PokerAttack.Client.Shared.EventArgs
@using ChefKnifeStudios.PokerAttack.Client.Shared.EventArgs.ModalEvents
@inject IEventNotificationService EventService
@inject NavigationManager NavigationManager

<MatDialog IsOpen="true" CanBeClosed="true" Closed="HandleClose">
    <MatDialogTitle>Game Result</MatDialogTitle>
    <MatDialogContent>
        @switch (GameResult)
        {
            case "winner":
                <p class="mat-body1">You are a winner</p>
                break;
            case "loser":
                <p class="mat-body1">You are a loser</p>
                break;
        }
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="HandleClose">Close</MatButton>
    </MatDialogActions>
</MatDialog>

@code {
    [Parameter] public required string GameResult { get; set; }

    void HandleClose()
    {
        NavigationManager.NavigateTo("/", replace: true);

        EventService.PostEvent(this, new MultiGameResultModalEventArgs
        {
            ModalAction = ModalEventArgs.ModalActions.Close,
            GameResult = GameResult
        });
    }
}
