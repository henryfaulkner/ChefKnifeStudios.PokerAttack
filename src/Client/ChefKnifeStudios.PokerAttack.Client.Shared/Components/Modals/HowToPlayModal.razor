<MatDialog
    IsOpen="true"
    CanBeClosed="true"
    IsOpenChanged="HandleOpenChanged"
    Class="how-to-play-modal"
>
    <MatDialogContent>
        <MatTabGroup>
            <MatTab Label="Quick Start">

            </MatTab>
            <MatTab Label="Docs">
                <iframe
                    src="https://docs.google.com/document/d/1oUnFL4Py3nW0i1YK4lK_VZI5plfe43_d9kG-FOUbAQU/edit?usp=sharing"
                    style="width: 100%; height: 100%;"
                ></iframe>
            </MatTab>
            <MatTab Label="Videos">

            </MatTab>
        </MatTabGroup>
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="@(() => HandleOpenChanged(false))">CLOSE</MatButton>
    </MatDialogActions>
</MatDialog>