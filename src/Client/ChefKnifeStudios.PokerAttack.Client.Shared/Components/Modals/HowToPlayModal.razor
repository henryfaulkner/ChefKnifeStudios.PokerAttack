<MatDialog
    IsOpen="true"
    CanBeClosed="true"
    IsOpenChanged="HandleOpenChanged"
    Class="how-to-play-modal"
>
    <MatDialogContent>
        <MatTabGroup>
            <MatTab Label="Quick Start Guide">
                <iframe
                    src="https://docs.google.com/document/d/1oUnFL4Py3nW0i1YK4lK_VZI5plfe43_d9kG-FOUbAQU/edit?tab=t.abntkh6lizv7"
                    style="width: 100%; height: 100%;"
                ></iframe>
            </MatTab>
            <MatTab Label="Game Manual">
                <iframe
                    src="https://docs.google.com/document/d/1oUnFL4Py3nW0i1YK4lK_VZI5plfe43_d9kG-FOUbAQU/edit?tab=t.0"
                    style="width: 100%; height: 100%;"
                ></iframe>
            </MatTab>
            @* <MatTab Label="Videos">
                <iframe
                    src="https://docs.google.com/document/d/1oUnFL4Py3nW0i1YK4lK_VZI5plfe43_d9kG-FOUbAQU/edit?tab=t.orfrp0fzelg7"
                    style="width: 100%; height: 100%;"
                ></iframe>
            </MatTab> *@
        </MatTabGroup>
    </MatDialogContent>
    <MatDialogActions>
        <MatButton OnClick="@(() => HandleOpenChanged(false))">CLOSE</MatButton>
    </MatDialogActions>
</MatDialog>