@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Modals
@using ChefKnifeStudios.PokerAttack.Client.Shared.Models

@if (ModalControllerViewModel.IsOpen)
{
    @RenderModal(ModalControllerViewModel.CurrentModal)
}

@code {
    RenderFragment RenderModal(ModalType modal) => modal switch
    {
        ModalType.ScoringRules => @<ScoringRulesModal />,
        ModalType.MultiGameResult => @<MultiGameResultModal GameResult="@(ModalControllerViewModel.ModalData as string ?? string.Empty)" />,
        ModalType.SoloGameResult => @<SoloGameResultModal />,
        ModalType.HowToPlay => @<HowToPlayModal />,
        _ => @<text></text>
    };
}
