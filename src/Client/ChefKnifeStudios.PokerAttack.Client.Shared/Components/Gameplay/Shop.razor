@using ChefKnifeStudios.PokerAttack.Client.Shared.Models
@using ChefKnifeStudios.PokerAttack.Shared
@using ChefKnifeStudios.PokerAttack.Client.Core.Extensions

<div class="shop">
    @if (GameDataStore.IsLoadingShop)
    {
        <div class="mat-body1">Loading...</div>
    }
    else
    {
        @foreach (var shopItem in GameDataStore.ShopItems)
        {
            <div class="shop__card">
                @ItemCategoryPill(shopItem)
                <span class="shop__card-name mat-h6">@shopItem.Name</span>
                <span class="shop__card-description mat-body1">@shopItem.Description</span>
                <span class="shop__card-cost mat-body1">Price: @shopItem.Price</span>
                
                @if (shopItem.WasPurchased)
                {
                    <MatButton
                        Disabled="true"
                    >
                        PURCHASED
                    </MatButton>
                }
                else
                {
                    <MatButton
                        OnClick="() => HandleItemPurchased(shopItem)"
                        OnClickStopPropagation="true"
                    >
                        BUY
                    </MatButton>
                }
            </div>
        }
        <span class="mat-h4">@ShopViewModel.ShopTimeSeconds.FormatAsMinutesSeconds()</span>
    }
</div>

@{
    RenderFragment ItemCategoryPill(ShopItem item)
    {
        return item.Root switch
        {
            ItemScoring => @<Pill Type="@PillTypes.Primary" Text="Scoring Item" />,
            ItemGameplay => @<Pill Type="@PillTypes.Secondary" Text="Gameplay Item" />,
            ItemWager => @<Pill Type="@PillTypes.Destructive" Text="Wager Item" />,
            _ => @<></>
        };
    }
}