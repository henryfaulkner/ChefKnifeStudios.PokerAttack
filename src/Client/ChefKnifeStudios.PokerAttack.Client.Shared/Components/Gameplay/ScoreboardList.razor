<div class="scoreboard-list">
    @if (ScoreboardViewModel.IsLoading)
    {
        <MatBody1>Loading...</MatBody1>
    }
    else
    {
        <MatTable
            Items="ScoreboardViewModel.Items"
            PageLabel="Scores"
            PageRecordCountLabel="Page Size"
        >
            <MatTableHeader>
                <th class="col-header-id">Player Id</th>
                <th class="col-header-name">Player Name</th>
                <th class="col-header-actions">Score</th>
            </MatTableHeader>
            <MatTableRow>
                @{
                    var rowClass = context switch
                    {
                        { IsEliminating: true } => "eliminating",
                        { IsEliminated: true } => "eliminated",
                        _ => string.Empty
                    };
                }
                <td class="col-row-id @rowClass">@context.ClientUserId</td>
                <td class="col-row-name">@context.ClientUserDisplayName</td>
                <td class="col-row-actions">@context.Score</td>
            </MatTableRow>
        </MatTable>
    }
</div>