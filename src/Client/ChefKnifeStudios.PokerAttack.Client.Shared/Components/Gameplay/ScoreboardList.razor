<div class="scoreboard-list">
    @if (ScoreboardViewModel.IsLoading)
    {
        <span class="mat-body1">Loading...</span>
    }
    else
    {
        <MatTable
            Items="ScoreboardViewModel.Items"
            PageLabel="Scores"
            PageRecordCountLabel="Page Size"
        >
            <MatTableHeader>
                <th class="col-header-id mat-body1">Player Id</th>
                <th class="col-header-name mat-body1">Player Name</th>
                <th class="col-header-actions mat-body1">Score</th>
            </MatTableHeader>
            <MatTableRow>
                @{
                    var rowClass = context switch
                    {
                        { IsEliminating: true } => "eliminating",
                        { IsEliminated: true } => "eliminated",
                        _ => string.Empty
                    };
                }
                <td class="col-row-id mat-body1 @rowClass">@context.ClientUserId</td>
                <td class="col-row-name mat-body1 @rowClass">@context.ClientUserDisplayName</td>
                <td class="col-row-actions mat-body1 @rowClass">@context.Score</td>
            </MatTableRow>
        </MatTable>
    }
</div>