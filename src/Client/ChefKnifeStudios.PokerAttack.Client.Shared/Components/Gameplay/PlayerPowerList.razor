<div class="player-power-list">
    @if (PlayerPowerListViewModel.IsLoading)
    {
        <div class="mat-body1">Loading...</div>
    }
    else
    {
        @foreach (var powerOption in PlayerPowerListViewModel.Items)
        {
            <div class="player-power-list__card @(powerOption.IsSelected ? "selected" : string.Empty)">
                <span class="player-power-list__card-name mat-h6">@powerOption.Name</span>
                <span class="player-power-list__card-description mat-body1">@powerOption.Description</span>
                <span class="player-power-list__card-cost mat-body1">Cost: 1</span>

                @if (powerOption.IsSelected)
                {
                    <span class="mat-body1">SELECTED</span>
                }
                else
                {
                    <MatButton 
                        OnClick="() => HandlePowerSelected(powerOption)"
                        OnClickStopPropagation="true"
                    >
                        Select Power
                    </MatButton>
                }
            </div>
        }
    }
</div>