@using ChefKnifeStudios.PokerAttack.Client.Shared.Components

@page "/"

<div class="main">
    <div class="container">
        <div style="display: flex; column-gap: 1rem; padding: 1rem 2rem;">
            <button @onclick="HandleCreateLobbyPressed" @onclick:stopPropagation="true">
                CREATE LOBBY
            </button>

            <span>You are <EditablePlayerName Player="@ApplicationViewModel.Player" /></span>
        </div>

        <div class="content">
            <LobbyList />
        </div>

        <MatDialog Class="game-result-modal" IsOpen="@(!string.IsNullOrWhiteSpace(GameResult))">
            <MatDialogContent>
                @switch (GameResult)
                {
                    case "winner":
                        <p>You are a winner</p>
                        break;
                    case "loser":
                        <p>You are a loser</p>
                        break;
                }
            </MatDialogContent>
            <MatDialogActions>
                <MatButton OnClick="HandleCloseModalPressed">CLOSE</MatButton>
            </MatDialogActions>
        </MatDialog>
    </div>
</div>