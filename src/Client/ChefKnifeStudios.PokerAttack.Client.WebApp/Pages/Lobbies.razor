@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Blades
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.FABs
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Gameplay
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Lobbies
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components
@using ChefKnifeStudios.PokerAttack.Shared.Enums

@page "/"

<div class="main">
    <FabList Fabs="[ FabList.FABs.Settings, FabList.FABs.Help, ]" />

    <div class="container">
        <div class="content">
            <div class="lobby-actions">
                <EditablePlayerName Player="@ApplicationViewModel.Player" />

                <MatButton
                    Id="createLobbyBtn"
                    Class="create-lobby-btn"
                    OnClick="HandleCreateLobbyPressed"
                    Unelevated
                >
                    CREATE LOBBY
                </MatButton>

                <MatButton
                    Id="playSoloBtn"
                    Class="play-solo-btn"
                    OnClick="HandlePlaySoloPressed"
                    Outlined
                >
                    PLAY SOLO
                </MatButton>

                @if (FeatureFlagService.IsEnabled(FeatureFlags.EnableHowToPlay))
                {
                    <MatButton
                        Id="scoringGuideBtn"
                        Class="scoring-guide-btn"
                        OnClick="HandleShowScoringGuidePressed"
                        Icon="help"
                    >
                        HOW TO SCORE
                    </MatButton>
                }
            </div>

            <LobbyList />
        </div>
    </div>
</div>