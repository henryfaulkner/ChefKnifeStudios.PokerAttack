@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Blades
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Gameplay
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Lobbies
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components
@using ChefKnifeStudios.PokerAttack.Shared.Enums

@page "/"

<div class="main">
    <div class="container">
        <div class="content">
            <div class="lobby-actions">
                <EditablePlayerName Player="@ApplicationViewModel.Player" />

                <MatButton 
                    Id="createLobbyBtn"
                    Class="create-lobby-btn"
                    OnClick="HandleCreateLobbyPressed"
                    Unelevated="true"
                >
                    CREATE LOBBY
                </MatButton>

                <MatButton
                    Id="playSoloBtn"
                    Class="play-solo-btn"
                    OnClick="HandlePlaySoloPressed"
                    Unelevated
                >
                    PLAY SOLO
                </MatButton>

                @if (FeatureFlagService.IsEnabled(FeatureFlags.EnableHowToPlay))
                {
                    <MatButton 
                        Id="scoringGuideBtn"
                        Class="scoring-guide-btn"
                        OnClick="HandleShowScoringGuidePressed" 
                        Icon="help"
                    >
                        HOW TO SCORE
                    </MatButton>
                }
            </div>

            <LobbyList />
        </div>

        <MatDialog Class="game-result-modal" IsOpen="@(!string.IsNullOrWhiteSpace(GameResult))">
            <MatDialogContent>
                @switch (GameResult)
                {
                    case "winner":
                        <p class="mat-body1">You are a winner</p>
                        break;
                    case "loser":
                        <p class="mat-body1">You are a loser</p>
                        break;
                }
            </MatDialogContent>
            <MatDialogActions>
                <MatButton OnClick="HandleCloseModalPressed">CLOSE</MatButton>
            </MatDialogActions>
        </MatDialog>

        <ScoringRulesModal 
            IsOpen="@_showScoringGuide" 
            OnClose="HandleCloseScoringGuidePressed"
        />
    </div>
</div>