@using ChefKnifeStudios.PokerAttack.Client.Shared.Components
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Gameplay
@using ChefKnifeStudios.PokerAttack.Client.Shared.EventArgs
@using ChefKnifeStudios.PokerAttack.Client.Shared.ViewModels
@using ChefKnifeStudios.PokerAttack.Shared.Enums

@page "/gameplay"

<div class="gameplay">
    <CascadingValue Value="GameStateMachineViewModel">
        @switch (GameStateMachineViewModel.GameState)
        {
            case GameStates.InGame:
                {
                    <div class="mat-layout-grid" style="padding: 0;">
                        <div class="mat-layout-grid-inner">
                            <div 
                                class="sidebar mat-layout-grid-cell mat-layout-grid-cell-span-3 bgclr-surface2"
                            >
                                <span>Score: @GameplayViewModel.Score</span>
                                <span>@FormatAsMinutesSeconds(GameplayViewModel.RunTimeInSeconds)</span>
                                <span>Hands Available: @GameplayViewModel.AvailablePlayHands</span>
                                <span>Discards Available: @GameplayViewModel.AvailableDiscards</span>
                                <span>Power: @(GameplayViewModel.ActivePlayerPower?.Name ?? "No Power???")</span>
                                <span>Power Charges: @GameplayViewModel.PowerCharges/2</span>
                            </div>
                            <div class="gaming-container mat-layout-grid-cell mat-layout-grid-cell-span-9">
                                <CardHand Cards="@GameplayViewModel.CardsInHand.ToList()" />

                                <div class="action-buttons">
                                    <MatButton Id="playHandBtn"
                                               Class="play-hand-btn action-btn"
                                               OnClick="HandlePlayHandPressed"
                                               Unelevated="true">
                                        <span class="key-bind">[Q]&nbsp;</span>PLAY HAND
                                    </MatButton>
                                    <MatButton Id="discardBtn"
                                               Class="discard-btn action-btn"
                                               OnClick="HandleDiscardPressed"
                                               Unelevated="true">
                                        <span class="key-bind">[W]&nbsp;</span>DISCARD
                                    </MatButton>
                                    <MatButton Id="activatePowerBtn"
                                               Class="activate-power-btn action-btn"
                                               OnClick="HandleActivatePowerPressed"
                                               Unelevated="true">
                                        <span class="key-bind">[E]&nbsp;</span>ACTIVATE POWER
                                    </MatButton>
                                    <MatButton Id="sortByRankBtn"
                                               Class="sort-by-rank-btn action-btn"
                                               OnClick="HandleSortByRankPressed"
                                               Unelevated="true">
                                        <span class="key-bind">[A]&nbsp;</span>SORT BY RANK
                                    </MatButton>
                                    <MatButton Id="sortBySuitBtn"
                                               Class="sort-by-suit-btn action-btn"
                                               OnClick="HandleSortBySuitPressed"
                                               Unelevated="true">
                                        <span class="key-bind">[S]&nbsp;</span>SORT BY SUIT
                                    </MatButton>
                                    <MatButton Id="clearSelectionsBtn"
                                               Class="clear-selections-btn action-btn"
                                               OnClick="HandleClearSelectionsPressed"
                                               Unelevated="true">
                                        <span class="key-bind">[D]&nbsp;</span>CLEAR SELECTIONS
                                    </MatButton>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                break;
            case GameStates.Scoreboard:
            case GameStates.Elimination:
                var viewText = GameStateMachineViewModel.GameState switch
                {
                    GameStates.Scoreboard => "Scoreboard",
                    GameStates.Elimination => "ELIMINATE LOW SCORERS",
                    _ => "?????"
                };

                <span>@viewText</span>
                <ScoreboardList GameId="@GameId" />
                break;
            case GameStates.Upgrade:
                <PlayerPowerList GameId="@GameId" />
                <span>WAITING ON OTHER PLAYERS' SELECTION</span>
                break;
            case GameStates.GameStart:
                {
                    <span>GAME STARTING</span>
                    break;
                }
        }
    </CascadingValue>
</div>