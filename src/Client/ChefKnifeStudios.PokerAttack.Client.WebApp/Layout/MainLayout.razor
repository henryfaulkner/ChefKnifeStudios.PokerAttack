@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Blades
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components

@inherits LayoutComponentBase

<div class="page bgclr-surface1">
    <MatThemeProvider Theme="@_theme">
        @Body

        <SettingsButton />
        <SettingsBlade />

        <MatToastContainer />
    </MatThemeProvider>
</div>

@code 
{
    MatTheme _theme = new()
    {
        Background = ColorConstants.Surface1,
        OnPrimary = ColorConstants.OnPrimary,
        OnSecondary = ColorConstants.OnSecondaryContainer,
        OnSurface = ColorConstants.OnTertiaryContainer,
        Primary = ColorConstants.Primary,
        Secondary = ColorConstants.SecondaryContainer,
        Surface = ColorConstants.Surface5,
    };
}