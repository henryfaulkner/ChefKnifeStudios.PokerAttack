@using ChefKnifeStudios.PokerAttack.Client.Core.Services
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Blades
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components
@using ChefKnifeStudios.PokerAttack.Client.Shared.Components.Lobbies
@using ChefKnifeStudios.PokerAttack.Client.Shared.EventArgs
@using ChefKnifeStudios.PokerAttack.Client.Shared.Services
@using ChefKnifeStudios.PokerAttack.Client.Shared.Services.JsInterop

@inherits LayoutComponentBase
@implements IDisposable
@inject ISettingsService SettingsService
@inject ICommonJsInterop CommonJsInterop
@inject IEventNotificationService EventNotificationService
@inject ISignalRNotificationService SignalRService
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

<div class="page bgclr-surface1">
    <MatThemeProvider Theme="@_theme">
        @if (_maintenance)
        {
            <div class="maintenance-notice" role="status" aria-live="polite">
                PokerAttack is in maintenance. You can finish your current game.
                New games will reopen after the release. Reload afterward to start a fresh session.
            </div>
        }
        <div class="session-content" inert="@(SignalRService.RequiresReload || SignalRService.ConnectionStatus != ConnectionRecoveryState.Connected)">
            @Body
            <SettingsBlade />
            <ModalController />
            <MatToastContainer />
        </div>
        @if (!SignalRService.RequiresReload && SignalRService.ConnectionStatus != ConnectionRecoveryState.Connected)
        {
            <div class="connection-recovery" role="status" aria-live="polite">
                <div class="connection-recovery-card">@(_maintenance
                    ? "PokerAttack is in maintenance. Reload after maintenance to reconnect."
                    : "Connecting to PokerAttack…")</div>
            </div>
        }
        @if (SignalRService.RequiresReload)
        {
            <div class="connection-recovery" role="alertdialog" aria-modal="true" aria-labelledby="connection-recovery-title">
                <div class="connection-recovery-card">
                    <h2 id="connection-recovery-title">Connection interrupted</h2>
                    <p>@(SignalRService.ConnectionStatus == ConnectionRecoveryState.Reconnecting
                        ? "Trying to reconnect. Your current match may have ended."
                        : "Reload to reconnect and start or join a new lobby. Your previous match cannot be restored from this page.")</p>
                    <button type="button" @onclick="ReloadHome">Reload and return home</button>
                </div>
            </div>
        }
    </MatThemeProvider>
</div>

@code
{
    MatTheme _theme = null!;
    readonly CancellationTokenSource _maintenanceCancellation = new();
    bool _maintenance;

    static readonly MatTheme LightTheme = new()
    {
        Background = ColorConstants.Light.Background,
        OnPrimary = ColorConstants.Light.OnPrimary,
        OnSecondary = ColorConstants.Light.OnSecondary,
        OnSurface = ColorConstants.Light.OnSurface,
        Primary = ColorConstants.Light.Primary,
        Secondary = ColorConstants.Light.Secondary,
        Surface = ColorConstants.Light.Surface,
    };

    static readonly MatTheme DarkTheme = new()
    {
        Background = ColorConstants.Dark.Background,
        OnPrimary = ColorConstants.Dark.OnPrimary,
        OnSecondary = ColorConstants.Dark.OnSecondary,
        OnSurface = ColorConstants.Dark.OnSurface,
        Primary = ColorConstants.Dark.Primary,
        Secondary = ColorConstants.Dark.Secondary,
        Surface = ColorConstants.Dark.Surface,
    };

    protected override void OnInitialized()
    {
        var settings = SettingsService.GetSettings();
        _theme = settings.IsDarkModeEnabled ? DarkTheme : LightTheme;

        EventNotificationService.EventReceived += HandleEventReceived;
        SignalRService.ConnectionStateChanged += HandleConnectionStateChanged;
        _ = WatchMaintenanceAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var settings = SettingsService.GetSettings();
            var themeName = settings.IsDarkModeEnabled ? "dark" : "light";
            await CommonJsInterop.SetThemeAsync(themeName);
        }
    }

    async Task HandleEventReceived(object sender, IEventArgs e)
    {
        if (e is ThemeChangedEventArgs themeArgs)
        {
            _theme = themeArgs.IsDarkMode ? DarkTheme : LightTheme;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _maintenanceCancellation.Cancel();
        EventNotificationService.EventReceived -= HandleEventReceived;
        SignalRService.ConnectionStateChanged -= HandleConnectionStateChanged;
    }

    void HandleConnectionStateChanged() => _ = InvokeAsync(StateHasChanged);
    void ReloadHome() => Navigation.NavigateTo(Navigation.BaseUri, forceLoad: true);

    async Task WatchMaintenanceAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        using var client = HttpClientFactory.CreateClient("PokerAttackAPI");
        try
        {
            do
            {
                try
                {
                    using var bounded = CancellationTokenSource.CreateLinkedTokenSource(_maintenanceCancellation.Token);
                    bounded.CancelAfter(TimeSpan.FromSeconds(5));
                    using var response = await client.GetAsync("release/status", bounded.Token);
                    if (response.IsSuccessStatusCode)
                    {
                        using var state = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync(bounded.Token));
                        _maintenance = state.RootElement.GetProperty("maintenance").GetBoolean();
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (Exception) when (!_maintenanceCancellation.IsCancellationRequested)
                {
                    // Preserve the last maintenance state during replacement.
                    // Existing connection recovery handles unavailable APIs.
                }
            } while (await timer.WaitForNextTickAsync(_maintenanceCancellation.Token));
        }
        catch (OperationCanceledException) when (_maintenanceCancellation.IsCancellationRequested) { }
    }
}
