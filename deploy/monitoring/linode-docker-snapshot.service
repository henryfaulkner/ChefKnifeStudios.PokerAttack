[Unit]
Description=Read-only Docker inventory and resource snapshot
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /opt/linode-docker-metrics/docker_snapshot.py
StateDirectory=linode-docker-metrics
StateDirectoryMode=0755
UMask=0022
TimeoutStartSec=25s
KillMode=control-group
MemoryMax=64M
CPUQuota=10%
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/var/lib/linode-docker-metrics
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
StandardOutput=null
StandardError=journal
