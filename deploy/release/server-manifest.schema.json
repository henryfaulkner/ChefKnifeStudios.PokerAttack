{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PokerAttack server v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source_sha",
    "workflow",
    "api",
    "migration",
    "config_sha256",
    "schema",
    "verification_references"
  ],
  "properties": {
    "format": {
      "const": "pokerattack-server-v1"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "run_id",
        "run_attempt",
        "run_url"
      ],
      "properties": {
        "repository": {
          "const": "henryfaulkner/ChefKnifeStudios.PokerAttack"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "run_url": {
          "type": "string",
          "pattern": "^https://github.com/henryfaulkner/ChefKnifeStudios[.]PokerAttack/actions/runs/[0-9]+$"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "local_image_id",
        "tag",
        "source_revision",
        "platform"
      ],
      "properties": {
        "repository": {
          "const": "chefknife.azurecr.io/chefknifestudios.pokerattack.server.webapi"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "local_image_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "platform": {
          "const": "linux/amd64"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "local_image_id",
        "tag",
        "source_revision",
        "platform"
      ],
      "properties": {
        "repository": {
          "const": "chefknife.azurecr.io/chefknifestudios.pokerattack.server.data"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "local_image_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "platform": {
          "const": "linux/amd64"
        }
      }
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_migrations",
        "compatible_with_known_good",
        "review_reference"
      ],
      "properties": {
        "required_migrations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{14}_[A-Za-z0-9_]+$"
          }
        },
        "compatible_with_known_good": {
          "const": true
        },
        "review_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "verification_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}
