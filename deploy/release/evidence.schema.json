{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PokerAttack evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source_sha",
    "workflow",
    "digest",
    "migration_digest",
    "config_sha256",
    "client_source_sha",
    "client_archive_sha256",
    "verifier_id",
    "verified_unix",
    "checks",
    "artifact_references"
  ],
  "properties": {
    "format": {
      "const": "pokerattack-evidence-v1"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "run_id",
        "run_attempt",
        "run_url"
      ],
      "properties": {
        "repository": {
          "const": "henryfaulkner/ChefKnifeStudios.PokerAttack"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "run_url": {
          "type": "string",
          "pattern": "^https://github.com/henryfaulkner/ChefKnifeStudios[.]PokerAttack/actions/runs/[0-9]+$"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "migration_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "client_source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "client_archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verifier_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "verified_unix": {
      "type": "integer",
      "minimum": 1
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "https",
        "served_client",
        "signalr",
        "multiplayer",
        "solo",
        "private_message_isolation"
      ],
      "properties": {
        "https": {
          "const": true
        },
        "served_client": {
          "const": true
        },
        "signalr": {
          "const": true
        },
        "multiplayer": {
          "const": true
        },
        "solo": {
          "const": true
        },
        "private_message_isolation": {
          "const": true
        }
      }
    },
    "artifact_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}
