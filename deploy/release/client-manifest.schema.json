{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PokerAttack client v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source_sha",
    "workflow",
    "artifact_id",
    "archive_sha256",
    "settings_sha256",
    "files",
    "minimum_server_capability",
    "verification_references"
  ],
  "properties": {
    "format": {
      "const": "pokerattack-client-v1"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "run_id",
        "run_attempt",
        "run_url"
      ],
      "properties": {
        "repository": {
          "const": "henryfaulkner/ChefKnifeStudios.PokerAttack"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "run_url": {
          "type": "string",
          "pattern": "^https://github.com/henryfaulkner/ChefKnifeStudios[.]PokerAttack/actions/runs/[0-9]+$"
        }
      }
    },
    "artifact_id": {
      "type": "integer",
      "minimum": 1
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "settings_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100000,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_./@+ -]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "minimum_server_capability": {
      "type": "integer",
      "minimum": 1
    },
    "verification_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}
