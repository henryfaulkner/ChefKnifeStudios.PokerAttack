# Production. Scripts generate this file from the validated digest and fixed paths.
API_IMAGE=chefknife.azurecr.io/chefknifestudios.pokerattack.server.webapi@sha256:REPLACE_WITH_64_LOWERCASE_HEX
APP_ENV=/etc/pokerattack/production/app.env
APP_PORT=8081
# Pilot uses /etc/pokerattack/pilot/app.env and 8082 with a separate Compose project.
